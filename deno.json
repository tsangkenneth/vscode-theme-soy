{
  "tasks": {
    "build": "deno run --allow-read=. --allow-write=themes,package.json src/main.ts",
    "check": "deno fmt --check && deno lint && deno check src scripts && deno run scripts/check.ts"
  },
  "nodeModulesDir": "none",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["samples/"],
  "fmt": {
    "exclude": ["themes/"]
  }
}
